# ── Docker Compose environment ───────────────────────────────────────────────
# Copy to `.env.docker` and edit the domains for a real deployment:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# APP_KEY is generated automatically on first boot — leave it empty.

APP_NAME="Laravel Next Starter Kit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The API's own URL (internal). Email links point to FRONTEND_URL, not this.
APP_URL=http://api

# ── Public URLs / Sanctum SPA ────────────────────────────────────────────────
# FRONTEND_URL: where the browser reaches the Next app (used in mail links).
# SANCTUM_STATEFUL_DOMAINS: the origin the browser sends (forwarded by the proxy)
# PLUS the internal API host that SSR getUser() presents as its Origin (`api`).
# For a real deploy replace `localhost:3000` with your public frontend domain.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,api

# Host port the Next app is published on.
FRONTEND_PORT=3000

# ── Session / cookies ────────────────────────────────────────────────────────
# SESSION_DOMAIN stays null so the cookie is host-only and the browser accepts
# it for the frontend domain (do NOT pin it to the API host).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
# Must match the name proxy.ts checks for in its optimistic guard. Without this,
# Laravel derives the cookie name from APP_NAME and the guard never sees it.
SESSION_COOKIE=laravel_session
# Set true once you serve the frontend over HTTPS.
SESSION_SECURE_COOKIE=false

# ── Database (MySQL service) ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret

# ── Queue / cache / mail ─────────────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
# Swap for a real SMTP provider in production.
MAIL_MAILER=log
